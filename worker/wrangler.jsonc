{
  "name": "claude-autofix-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [{ "binding": "DB", "database_name": "claude-autofix-hub" }],
  "kv_namespaces": [{ "binding": "STATE" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "APP_CLIENT_ID": "",
    "APP_SLUG": "",
    "RUNNER_REPOSITORY": "",
    "RUNNER_REF": "main",
    "ACTION_REPOSITORY": "Mackery6969/Claude-Autofix",
    "ACTION_VERSION": "v3",
    "PERMITTED_OWNERS": "",
    "IGNORED_REPOSITORIES": ""
  }
}
